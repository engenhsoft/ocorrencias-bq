+// Additive CHAVES schema. Run once in the EXISTING project before updating its deployment.
+// Preflight every target before any write; never rewrite historical operational rows.
+function installChavesSchema_() {
+  const lock = LockService.getScriptLock(); lock.waitLock(30000);
+  try {
+    const targets = [sheet_(APP.pendingSheet), sheet_(APP.officialSheet)];
+    targets.forEach(function (sheet) {
+      const prefix = sheet.getRange(1, 1, 1, 46).getDisplayValues()[0];
+      if (publicationJson_(prefix) !== publicationJson_(MAIN_HEADERS.slice(0, 46))) throw apiError_('CHAVES_SCHEMA_CONFLICT', 'Cabeçalhos existentes divergentes: ' + sheet.getName());
+      const available = Math.max(0, Math.min(5, sheet.getMaxColumns() - 46));
+      if (!available) return;
+      const rows = sheet.getRange(1, 47, Math.max(1, sheet.getLastRow()), available).getValues();
+      const header = rows[0].map(String);
+      if (available === 5 && publicationJson_(header) === publicationJson_(MAIN_HEADERS.slice(46))) return;
+      if (rows.some(function (row) { return row.some(function (value) { return value !== '' && value != null; }); })) throw apiError_('CHAVES_SCHEMA_CONFLICT', 'As novas colunas já contêm dados: ' + sheet.getName());
+    });
+    targets.forEach(function (sheet) {
+      if (sheet.getMaxColumns() < COL.WIDTH) sheet.insertColumnsAfter(sheet.getMaxColumns(), COL.WIDTH - sheet.getMaxColumns());
+      const current = sheet.getRange(1, 47, 1, 5).getDisplayValues()[0];
+      if (publicationJson_(current) !== publicationJson_(MAIN_HEADERS.slice(46))) sheet.getRange(1, 47, 1, 5).setValues([MAIN_HEADERS.slice(46)]);
+    });
+    flushSheets_(); assertCorrectionHeaders_();
+    return { ok: true, columnsAdded: [47, 48, 49, 50, 51], historicalRecordWrites: 0 };
+  } finally { lock.releaseLock(); }
+}
+function chavesModelFields_(model) {
+  const fields = ['pgKeyRemoved', 'btoKeyRemoved', 'pgKeyInstalled', 'btoKeyInstalled'];
+  if (!Number(model.formVersion) && !fields.some(function (key) { return String(model[key] || '').trim(); })) return {};
+  const result = {};
+  fields.forEach(function (key) { result[key] = String(model[key] == null ? '' : model[key]); });
+  if (Number(model.formVersion)) result.formVersion = Number(model.formVersion);
+  return result;
+}
+function chavesFieldsFromValues_(values) {
+  return chavesModelFields_({ pgKeyRemoved: values[COL.PG_KEY_REMOVED - 1], btoKeyRemoved: values[COL.BTO_KEY_REMOVED - 1],
+    pgKeyInstalled: values[COL.PG_KEY_INSTALLED - 1], btoKeyInstalled: values[COL.BTO_KEY_INSTALLED - 1], formVersion: values[COL.FORM_VERSION - 1] });
+}
+function formatChavesRow_(sheet, row, height) {
+  if (typeof sheet.getMaxRows === 'function' && row + height - 1 > sheet.getMaxRows()) sheet.insertRowsAfter(sheet.getMaxRows(), row + height - 1 - sheet.getMaxRows());
+  const range = sheet.getRange(row, COL.PG_KEY_REMOVED, height, 4);
+  if (typeof range.setNumberFormat === 'function') range.setNumberFormat('@');
+}
